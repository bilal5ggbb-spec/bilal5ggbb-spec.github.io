#!/usr/bin/env python3
import sys
import re
import math
from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QLineEdit, QPushButton, QProgressBar, QFrame
)
from PyQt6.QtCore import Qt
from PyQt6.QtGui import QFont

class ArabicPasswordChecker(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("أداة فحص أمان وقوة كلمات المرور - Kali Linux")
        self.setFixedSize(460, 560)
        self.setLayoutDirection(Qt.LayoutDirection.RightToLeft)
        self.setStyleSheet("""
            QWidget {
                background-color: #161b22;
                color: #e6edf3;
                font-family: 'DejaVu Sans', 'Arial', sans-serif;
            }
            QLineEdit {
                background-color: #0d1117;
                border: 2px solid #30363d;
                border-radius: 8px;
                padding: 10px;
                font-size: 15px;
                color: #ffffff;
            }
            QLineEdit:focus {
                border: 2px solid #2ea043;
            }
            QPushButton {
                background-color: #21262d;
                border: 1px solid #30363d;
                border-radius: 8px;
                padding: 8px 14px;
                color: #c9d1d9;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #30363d;
            }
            QProgressBar {
                border: 1px solid #30363d;
                border-radius: 6px;
                background-color: #0d1117;
                text-align: center;
                height: 18px;
                font-weight: bold;
            }
            QProgressBar::chunk {
                background-color: #2ea043;
                border-radius: 5px;
            }
        """)
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(25, 25, 25, 25)
        layout.setSpacing(14)

        self.lock_icon = QLabel("🔒")
        self.lock_icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.lock_icon.setStyleSheet("""
            font-size: 54px;
            background-color: #1f3a2c;
            border: 2px solid #2ea043;
            border-radius: 45px;
            padding: 12px;
        """)
        self.lock_icon.setFixedSize(90, 90)

        icon_container = QHBoxLayout()
        icon_container.addStretch()
        icon_container.addWidget(self.lock_icon)
        icon_container.addStretch()
        layout.addLayout(icon_container)

        title = QLabel("فاحص قوة كلمة المرور")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        title.setFont(QFont("DejaVu Sans", 16, QFont.Weight.Bold))
        layout.addWidget(title)

        input_layout = QHBoxLayout()
        self.pwd_input = QLineEdit()
        self.pwd_input.setPlaceholderText("أدخل كلمة المرور هنا...")
        self.pwd_input.setEchoMode(QLineEdit.EchoMode.Password)
        self.pwd_input.textChanged.connect(self.check_password)

        self.toggle_btn = QPushButton("إظهار")
        self.toggle_btn.setCheckable(True)
        self.toggle_btn.clicked.connect(self.toggle_password)

        input_layout.addWidget(self.pwd_input)
        input_layout.addWidget(self.toggle_btn)
        layout.addLayout(input_layout)

        self.status_label = QLabel("الحالة: بانتظار الإدخال")
        self.status_label.setStyleSheet("font-size: 13px; font-weight: bold; color: #8b949e;")
        layout.addWidget(self.status_label)

        self.progress_bar = QProgressBar()
        self.progress_bar.setRange(0, 100)
        self.progress_bar.setValue(0)
        layout.addWidget(self.progress_bar)

        line = QFrame()
        line.setFrameShape(QFrame.Shape.HLine)
        line.setStyleSheet("color: #30363d;")
        layout.addWidget(line)

        criteria_title = QLabel("معايير الأمان المطلوبة:")
        criteria_title.setStyleSheet("font-weight: bold; color: #58a6ff;")
        layout.addWidget(criteria_title)

        self.c_length = QLabel("✖ الطول لا يقل عن 8 أحرف")
        self.c_upper = QLabel("✖ تحتوي على حرف كبير (A-Z)")
        self.c_lower = QLabel("✖ تحتوي على حرف صغير (a-z)")
        self.c_digit = QLabel("✖ تحتوي على أرقام (0-9)")
        self.c_special = QLabel("✖ تحتوي على رموز خاصة (!@#$%)")
        self.entropy_label = QLabel("معدل العشوائية (Entropy): 0 bits")

        for lbl in [self.c_length, self.c_upper, self.c_lower, self.c_digit, self.c_special]:
            lbl.setStyleSheet("color: #f85149; font-size: 13px;")
            layout.addWidget(lbl)

        self.entropy_label.setStyleSheet("color: #8b949e; font-size: 12px; margin-top: 6px;")
        layout.addWidget(self.entropy_label)

        layout.addStretch()
        self.setLayout(layout)

    def toggle_password(self):
        if self.toggle_btn.isChecked():
            self.pwd_input.setEchoMode(QLineEdit.EchoMode.Normal)
            self.toggle_btn.setText("إخفاء")
        else:
            self.pwd_input.setEchoMode(QLineEdit.EchoMode.Password)
            self.toggle_btn.setText("إظهار")

    def update_criterion(self, label, passed, text):
        if passed:
            label.setText(f"✔ {text}")
            label.setStyleSheet("color: #3fb950; font-size: 13px; font-weight: bold;")
        else:
            label.setText(f"✖ {text}")
            label.setStyleSheet("color: #f85149; font-size: 13px;")

    def check_password(self, text):
        has_len = len(text) >= 8
        has_upper = bool(re.search(r"[A-Z]", text))
        has_lower = bool(re.search(r"[a-z]", text))
        has_digit = bool(re.search(r"[0-9]", text))
        has_special = bool(re.search(r"[^A-Za-z0-9]", text))

        self.update_criterion(self.c_length, has_len, "الطول لا يقل عن 8 أحرف")
        self.update_criterion(self.c_upper, has_upper, "تحتوي على حرف كبير (A-Z)")
        self.update_criterion(self.c_lower, has_lower, "تحتوي على حرف صغير (a-z)")
        self.update_criterion(self.c_digit, has_digit, "تحتوي على أرقام (0-9)")
        self.update_criterion(self.c_special, has_special, "تحتوي على رموز خاصة (!@#$%)")

        score = sum([has_len, has_upper, has_lower, has_digit, has_special]) * 20
        if len(text) == 0:
            score = 0

        self.progress_bar.setValue(score)

        pool = (26 if has_lower else 0) + (26 if has_upper else 0) + (10 if has_digit else 0) + (32 if has_special else 0)
        entropy = int(len(text) * math.log2(pool)) if pool > 0 else 0
        self.entropy_label.setText(f"معدل العشوائية (Entropy): {entropy} bits")

        if score == 0:
            self.status_label.setText("الحالة: بانتظار الإدخال")
            self.status_label.setStyleSheet("color: #8b949e; font-weight: bold;")
            self.lock_icon.setText("🔒")
        elif score <= 40:
            self.status_label.setText("الحالة: ضعيفة جداً (سهلة الاختراق)")
            self.status_label.setStyleSheet("color: #f85149; font-weight: bold;")
            self.progress_bar.setStyleSheet("QProgressBar::chunk { background-color: #f85149; border-radius: 5px; }")
            self.lock_icon.setText("🔓")
        elif score <= 80:
            self.status_label.setText("الحالة: متوسطة (تحتاج تحسين)")
            self.status_label.setStyleSheet("color: #d29922; font-weight: bold;")
            self.progress_bar.setStyleSheet("QProgressBar::chunk { background-color: #d29922; border-radius: 5px; }")
            self.lock_icon.setText("🔒")
        else:
            self.status_label.setText("الحالة: قوية جداً (آمنة)")
            self.status_label.setStyleSheet("color: #2ea043; font-weight: bold;")
            self.progress_bar.setStyleSheet("QProgressBar::chunk { background-color: #2ea043; border-radius: 5px; }")
            self.lock_icon.setText("🛡️")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = ArabicPasswordChecker()
    window.show()
    sys.exit(app.exec())
